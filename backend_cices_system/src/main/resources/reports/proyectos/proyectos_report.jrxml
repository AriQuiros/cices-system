<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="proyectos_report"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="20"
        bottomMargin="20">

    <!-- ========================= -->
    <!-- STYLES — todo en negro    -->
    <!-- ========================= -->

    <!-- Fuente base del documento -->
    <style name="BaseFont" isDefault="true"
           fontName="Arial" fontSize="10" pdfFontName="Helvetica"
           forecolor="#000000"/>

    <!-- Título principal del reporte (encabezado de página) -->
    <style name="Title"
           fontName="Arial"
           fontSize="18"
           isBold="true"
           forecolor="#000000"/>

    <!-- Subtítulo / nombre del sistema -->
    <style name="Heading2"
           fontName="Arial"
           fontSize="13"
           isBold="true"
           forecolor="#000000"/>

    <!-- Heading1: código de proyecto — encabezado de cada ficha -->
    <style name="Heading1"
           fontName="Arial"
           fontSize="14"
           isBold="true"
           forecolor="#000000"/>

    <!-- Texto del cuerpo de la ficha -->
    <style name="BodyText"
           fontName="Arial"
           fontSize="11"
           isBold="false"
           forecolor="#000000"/>

    <!-- Texto del footer (más pequeño, pero también negro) -->
    <style name="FooterText"
           fontName="Arial"
           fontSize="9"
           forecolor="#000000"/>

    <!-- ========================= -->
    <!-- PARAMETERS                -->
    <!-- ========================= -->

    <parameter name="SISTEMA_NOMBRE"   class="java.lang.String"/>
    <parameter name="REPORTE_TITULO"   class="java.lang.String"/>
    <parameter name="FECHA_GENERACION" class="java.lang.String"/>
    <parameter name="PIE_TEXTO"        class="java.lang.String"/>
    <parameter name="LOGO_PATH"        class="java.lang.Object"/>

    <!-- ========================= -->
    <!-- FIELDS                    -->
    <!-- ========================= -->

    <field name="codigoProyecto"      class="java.lang.String"/>
    <field name="nombreProyecto"      class="java.lang.String"/>
    <field name="lineaInvestigacion"  class="java.lang.String"/>
    <field name="tipoProyecto"        class="java.lang.String"/>
    <field name="estado"              class="java.lang.String"/>
    <field name="fechaInicio"         class="java.time.LocalDate"/>
    <field name="fechaFinalizacion"   class="java.time.LocalDate"/>

    <!-- ========================= -->
    <!-- PAGE HEADER               -->
    <!-- ========================= -->

    <pageHeader>
        <band height="110">

            <!-- Logo (opcional) -->
            <image scaleImage="RetainShape">
                <reportElement x="0" y="10" width="60" height="60">
                    <printWhenExpression><![CDATA[$P{LOGO_PATH} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression>
            </image>

            <!-- Nombre del sistema -->
            <textField>
                <reportElement style="Heading2" x="70" y="10" width="500" height="20"/>
                <textFieldExpression><![CDATA[$P{SISTEMA_NOMBRE}]]></textFieldExpression>
            </textField>

            <!-- Título del reporte -->
            <textField>
                <reportElement style="Title" x="70" y="32" width="500" height="30"/>
                <textFieldExpression><![CDATA[$P{REPORTE_TITULO}]]></textFieldExpression>
            </textField>

            <!-- Fecha de generación (derecha) -->
            <textField>
                <reportElement style="FooterText" x="600" y="10" width="180" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Fecha: " + $P{FECHA_GENERACION}]]></textFieldExpression>
            </textField>

            <!-- Línea separadora bajo el encabezado -->
            <line>
                <reportElement x="0" y="100" width="782" height="1" forecolor="#000000"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>

        </band>
    </pageHeader>

    <!-- ========================= -->
    <!-- DETAIL — FICHA POR        -->
    <!-- PROYECTO                  -->
    <!-- ========================= -->

    <detail>
        <band height="145" splitType="Stretch">

            <!-- ── HEADING 1: Código de proyecto ── -->
            <textField>
                <reportElement style="Heading1" x="0" y="6" width="782" height="22"/>
                <textFieldExpression><![CDATA[$F{codigoProyecto}]]></textFieldExpression>
            </textField>

            <!-- Línea fina bajo el Heading1 -->
            <line>
                <reportElement x="0" y="30" width="782" height="1" forecolor="#000000"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <!-- Nombre del proyecto -->
            <textField isStretchWithOverflow="true">
                <reportElement style="BodyText" x="0" y="36" width="782" height="18"/>
                <textFieldExpression><![CDATA["Nombre: " + $F{nombreProyecto}]]></textFieldExpression>
            </textField>

            <!-- Línea de investigación -->
            <textField isStretchWithOverflow="true">
                <reportElement style="BodyText" x="0" y="56" width="782" height="18"/>
                <textFieldExpression><![CDATA["Línea de investigación: " + $F{lineaInvestigacion}]]></textFieldExpression>
            </textField>

            <!-- Tipo de proyecto -->
            <textField>
                <reportElement style="BodyText" x="0" y="76" width="380" height="18"/>
                <textFieldExpression><![CDATA["Tipo: " + $F{tipoProyecto}]]></textFieldExpression>
            </textField>

            <!-- Estado (columna derecha, misma fila que Tipo) -->
            <textField>
                <reportElement style="BodyText" x="390" y="76" width="392" height="18"/>
                <textFieldExpression><![CDATA["Estado: " + $F{estado}]]></textFieldExpression>
            </textField>

            <!-- Fechas -->
            <textField>
                <reportElement style="BodyText" x="0" y="96" width="782" height="18"/>
                <textFieldExpression><![CDATA[
                    "Período: " +
                    ($F{fechaInicio} != null ? $F{fechaInicio}.toString() : "—") +
                    " al " +
                    ($F{fechaFinalizacion} != null ? $F{fechaFinalizacion}.toString() : "—")
                ]]></textFieldExpression>
            </textField>

            <!-- Espacio entre fichas -->
            <line>
                <reportElement x="0" y="128" width="782" height="1" forecolor="#CCCCCC"/>
                <graphicElement>
                    <pen lineWidth="0.3" lineStyle="Dashed"/>
                </graphicElement>
            </line>

        </band>
    </detail>

    <!-- ========================= -->
    <!-- PAGE FOOTER               -->
    <!-- ========================= -->

    <pageFooter>
        <band height="30">

            <!-- Línea sobre el footer -->
            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#000000"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>

            <!-- Texto del pie izquierdo -->
            <textField>
                <reportElement style="FooterText" x="0" y="8" width="500" height="20"/>
                <textFieldExpression><![CDATA[$P{PIE_TEXTO}]]></textFieldExpression>
            </textField>

            <!-- Número de página (derecha) -->
            <textField evaluationTime="Report">
                <reportElement style="FooterText" x="500" y="8" width="282" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    "Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}
                ]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

</jasperReport>
