<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="certificaciones_report"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="20"
    bottomMargin="20"
    uuid="a1b2c3d4-0002-0002-0002-000000000002">

    <!-- 1. STYLES -->

    <style name="BaseFont"
        isDefault="true"
        fontName="DejaVu Sans"
        fontSize="8"
        pdfFontName="Helvetica"/>

    <style name="SystemName"
        fontName="DejaVu Sans"
        fontSize="10"
        isBold="true"
        forecolor="#1E3A5F"/>

    <style name="ReportTitle"
        fontName="DejaVu Sans"
        fontSize="13"
        isBold="true"
        forecolor="#1E3A5F"/>

    <style name="DateText"
        fontName="DejaVu Sans"
        fontSize="7"
        forecolor="#666666"/>

    <style name="FooterText"
        fontName="DejaVu Sans"
        fontSize="7"
        forecolor="#666666"/>

    <style name="ColHeader"
        fontName="DejaVu Sans"
        fontSize="8"
        isBold="true"
        forecolor="#FFFFFF"
        backcolor="#1E3A5F"
        hTextAlign="Center"
        vTextAlign="Middle"/>

    <style name="BadgeVigente"
        fontName="DejaVu Sans"
        fontSize="8"
        isBold="true"
        forecolor="#FFFFFF"
        backcolor="#2E7D32"
        mode="Opaque"/>

    <style name="BadgeVencido"
        fontName="DejaVu Sans"
        fontSize="8"
        isBold="true"
        forecolor="#FFFFFF"
        backcolor="#C62828"
        mode="Opaque"/>

    <style name="BadgePendiente"
        fontName="DejaVu Sans"
        fontSize="8"
        isBold="true"
        forecolor="#FFFFFF"
        backcolor="#E65100"
        mode="Opaque"/>

    <style name="BadgeDefault"
        fontName="DejaVu Sans"
        fontSize="8"
        isBold="true"
        forecolor="#FFFFFF"
        backcolor="#546E7A"
        mode="Opaque"/>

    <style name="SummaryLabel"
        fontName="DejaVu Sans"
        fontSize="8"
        isBold="true"
        forecolor="#1E3A5F"/>

    <!-- 2. PARAMETERS -->

    <parameter name="SISTEMA_NOMBRE" class="java.lang.String">
        <defaultValueExpression><![CDATA["CICES"]]></defaultValueExpression>
    </parameter>

    <parameter name="REPORTE_TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Reporte de Certificaciones"]]></defaultValueExpression>
    </parameter>

    <parameter name="FECHA_GENERACION" class="java.lang.String">
        <defaultValueExpression><![CDATA["--/--/----"]]></defaultValueExpression>
    </parameter>

    <parameter name="PIE_TEXTO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Documento generado automaticamente."]]></defaultValueExpression>
    </parameter>

    <parameter name="LOGO_PATH" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <!-- 3. FIELDS — nombres exactos del record FormacionDTO
         record FormacionDTO(
             String identificacionInvestigador,
             String nombreInvestigador,
             String nombre,           <- nombre de la certificacion
             String institucion,
             String tipo,
             String estado,
             LocalDate fecha
         )
         JasperReports usa los accessors del record como getters.
         LocalDate se formatea en la expresion del campo.
    -->

    <field name="identificacionInvestigador" class="java.lang.String"/>
    <field name="nombreInvestigador"         class="java.lang.String"/>
    <field name="nombre"                     class="java.lang.String"/>
    <field name="institucion"                class="java.lang.String"/>
    <field name="tipo"                       class="java.lang.String"/>
    <field name="estado"                     class="java.lang.String"/>
    <field name="fecha"                      class="java.time.LocalDate"/>

    <!-- 4. VARIABLES -->

    <variable name="TOTAL_REGISTROS" class="java.lang.Integer" calculation="Count" resetType="Report">
        <variableExpression><![CDATA[$F{identificacionInvestigador}]]></variableExpression>
    </variable>

    <variable name="TOTAL_VIGENTE" class="java.lang.Integer" calculation="Count" resetType="Report">
        <variableExpression><![CDATA[$F{estado} != null && $F{estado}.toUpperCase().contains("VIGENTE") && !$F{estado}.toUpperCase().contains("PROXIMA A VENCER") ? $F{estado} : null]]></variableExpression>
    </variable>

    <variable name="TOTAL_VENCIDO" class="java.lang.Integer" calculation="Count" resetType="Report">
        <variableExpression><![CDATA[$F{estado} != null && $F{estado}.toUpperCase().contains("VENCIDA") ? $F{estado} : null]]></variableExpression>
    </variable>

    <variable name="TOTAL_PENDIENTE" class="java.lang.Integer" calculation="Count" resetType="Report">
        <variableExpression><![CDATA[$F{estado} != null && $F{estado}.toUpperCase().contains("PROXIMA A VENCER") ? $F{estado} : null]]></variableExpression>
    </variable>

    <!-- 5. PAGE HEADER -->

    <pageHeader>
        <band height="60" splitType="Stretch">

            <rectangle>
                <reportElement x="0" y="0" width="782" height="4"
                    backcolor="#1E3A5F" forecolor="#1E3A5F" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <image onErrorType="Blank" scaleImage="RetainShape">
                <reportElement x="0" y="8" width="50" height="45">
                    <printWhenExpression><![CDATA[$P{LOGO_PATH} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression>
            </image>

            <textField>
                <reportElement style="SystemName" x="58" y="8" width="500" height="16"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{SISTEMA_NOMBRE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="ReportTitle" x="58" y="26" width="500" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{REPORTE_TITULO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="DateText" x="620" y="8" width="162" height="12"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Fecha de generacion:]]></text>
            </staticText>

            <textField>
                <reportElement style="DateText" x="620" y="20" width="162" height="12"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{FECHA_GENERACION}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="56" width="782" height="1" forecolor="#1E3A5F"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>

        </band>
    </pageHeader>

    <!-- 6. COLUMN HEADER -->

    <columnHeader>
        <band height="20" splitType="Stretch">

            <staticText>
                <reportElement style="ColHeader" x="0" y="0" width="140" height="20"/>
                <textElement textAlignment="Left"><paragraph leftIndent="4"/></textElement>
                <text><![CDATA[Investigador]]></text>
            </staticText>

            <staticText>
                <reportElement style="ColHeader" x="140" y="0" width="170" height="20"/>
                <textElement textAlignment="Left"><paragraph leftIndent="4"/></textElement>
                <text><![CDATA[Certificacion]]></text>
            </staticText>

            <staticText>
                <reportElement style="ColHeader" x="310" y="0" width="150" height="20"/>
                <textElement textAlignment="Left"><paragraph leftIndent="4"/></textElement>
                <text><![CDATA[Institucion]]></text>
            </staticText>

            <staticText>
                <reportElement style="ColHeader" x="460" y="0" width="109" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Tipo]]></text>
            </staticText>

            <staticText>
                <reportElement style="ColHeader" x="571" y="0" width="98" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Estado]]></text>
            </staticText>

            <staticText>
                <reportElement style="ColHeader" x="670" y="0" width="112" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Fecha Venc.]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- 7. DETAIL -->

    <detail>
        <band height="18" splitType="Stretch">

            <!-- Fondo alterno -->
            <rectangle>
                <reportElement x="0" y="0" width="782" height="18"
                    backcolor="#F5F8FC" forecolor="#F5F8FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <line>
                <reportElement x="0" y="17" width="782" height="1" forecolor="#E0E0E0"/>
                <graphicElement><pen lineWidth="0.3"/></graphicElement>
            </line>

            <!-- Investigador -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="1" width="140" height="16"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{nombreInvestigador}]]></textFieldExpression>
            </textField>

            <!-- Nombre certificacion -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="140" y="1" width="170" height="16"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <!-- Institucion -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="310" y="1" width="150" height="16"/>
                <textElement verticalAlignment="Middle"><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{institucion}]]></textFieldExpression>
            </textField>

            <!-- Tipo -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="460" y="1" width="109" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
            </textField>

            <!-- Estado — texto con forecolor condicional, sin depender de mode="Opaque" del badge -->
            <textField isBlankWhenNull="true">
                <reportElement x="570" y="1" width="100" height="16">
                    <styleExpression><![CDATA[
                        $F{estado} == null ? "BadgeDefault"
                        : $F{estado}.toUpperCase().contains("PROXIMA A VENCER") ? "BadgePendiente"
                        : $F{estado}.toUpperCase().contains("VENCIDA")          ? "BadgeVencido"
                        : $F{estado}.toUpperCase().contains("VIGENTE")           ? "BadgeVigente"
                        : "BadgeDefault"
                    ]]></styleExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>

            <!-- Fecha — LocalDate formateada -->
            <textField isBlankWhenNull="true">
                <reportElement x="670" y="1" width="112" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[
                    $F{fecha} != null
                        ? $F{fecha}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"))
                        : ""
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- 8. PAGE FOOTER -->

    <pageFooter>
        <band height="25" splitType="Stretch">

            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#CCCCCC"/>
            </line>

            <textField>
                <reportElement style="FooterText" x="0" y="5" width="550" height="15"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{PIE_TEXTO}]]></textFieldExpression>
            </textField>

            <!-- Número de página -->
            <textField>
                <reportElement style="FooterText" x="550" y="5" width="120" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>

            <!-- Total de páginas -->
            <textField evaluationTime="Report">
                <reportElement style="FooterText" x="670" y="5" width="112" height="15"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$V{PAGE_COUNT}]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    <!-- 9. SUMMARY -->

    <summary>
        <band height="135" splitType="Prevent">

            <!-- Línea separadora superior -->
            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#1E3A5F"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>

            <!-- Título del resumen -->
            <staticText>
                <reportElement style="SummaryLabel" x="0" y="8" width="200" height="14"/>
                <textElement><paragraph leftIndent="4"/></textElement>
                <text><![CDATA[Resumen de certificaciones]]></text>
            </staticText>

            <!-- Total de registros -->
            <staticText>
                <reportElement style="SummaryLabel" x="0" y="28" width="130" height="14"/>
                <textElement><paragraph leftIndent="4"/></textElement>
                <text><![CDATA[Total de registros:]]></text>
            </staticText>
            <textField>
                <reportElement style="SummaryLabel" x="130" y="28" width="60" height="14"/>
                <textFieldExpression><![CDATA[$V{TOTAL_REGISTROS}]]></textFieldExpression>
            </textField>

            <!-- Separador -->
            <line>
                <reportElement x="0" y="48" width="782" height="1" forecolor="#E0E0E0"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>

            <!-- Subtítulo por estado -->
            <staticText>
                <reportElement style="SummaryLabel" x="0" y="54" width="200" height="13"/>
                <textElement><paragraph leftIndent="4"/></textElement>
                <text><![CDATA[Cantidad por estado:]]></text>
            </staticText>

            <!-- Badge VIGENTE + conteo -->
            <textField isBlankWhenNull="true">
                <reportElement style="BadgeVigente" x="0" y="71" width="70" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["VIGENTE"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="SummaryLabel" x="76" y="71" width="130" height="14"/>
                <textFieldExpression><![CDATA["Vigentes: " + $V{TOTAL_VIGENTE}]]></textFieldExpression>
            </textField>

            <!-- Badge VENCIDA + conteo -->
            <textField isBlankWhenNull="true">
                <reportElement style="BadgeVencido" x="0" y="91" width="70" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["VENCIDA"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="SummaryLabel" x="76" y="91" width="130" height="14"/>
                <textFieldExpression><![CDATA["Vencidas: " + $V{TOTAL_VENCIDO}]]></textFieldExpression>
            </textField>

            <!-- Badge PROXIMA A VENCER + conteo -->
            <textField isBlankWhenNull="true">
                <reportElement style="BadgePendiente" x="0" y="111" width="130" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["PRÓXIMA A VENCER"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="SummaryLabel" x="136" y="111" width="180" height="14"/>
                <textFieldExpression><![CDATA["Próximas a vencer: " + $V{TOTAL_PENDIENTE}]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
