<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="certificaciones_report"
        pageWidth="842"
        pageHeight="595"
        orientation="Landscape"
        columnWidth="782"
        leftMargin="30"
        rightMargin="30"
        topMargin="20"
        bottomMargin="20">

    <!-- ========================= -->
    <!-- STYLES -->
    <!-- ========================= -->

    <style name="BaseFont" isDefault="true"
           fontName="Arial" fontSize="12" pdfFontName="Helvetica"/>

    <style name="Title"
           fontName="Arial" fontSize="18" isBold="true"
           forecolor="#1E3A5F"/>

    <style name="Heading2"
           fontName="Arial" fontSize="13" isBold="true"
           forecolor="#1E3A5F"/>

    <style name="TableHeader"
           fontName="Arial" fontSize="12" isBold="true"
           forecolor="#FFFFFF" backcolor="#1E3A5F"
           mode="Opaque" hTextAlign="Center" vTextAlign="Middle"/>

    <style name="TableCell"
           fontName="Arial" fontSize="12"
           forecolor="#000000" backcolor="#FFFFFF"
           mode="Opaque" vTextAlign="Middle"/>

    <style name="TableCellAlt"
           fontName="Arial" fontSize="12"
           forecolor="#000000" backcolor="#F5F5F5"
           mode="Opaque" vTextAlign="Middle"/>

    <style name="FooterText"
           fontName="Arial" fontSize="10"
           forecolor="#666666"/>

    <!-- ========================= -->
    <!-- PARAMETERS -->
    <!-- ========================= -->

    <parameter name="SISTEMA_NOMBRE" class="java.lang.String"/>
    <parameter name="REPORTE_TITULO" class="java.lang.String"/>
    <parameter name="FECHA_GENERACION" class="java.lang.String"/>
    <parameter name="PIE_TEXTO" class="java.lang.String"/>
    <parameter name="LOGO_PATH" class="java.lang.Object"/>

    <!-- ========================= -->
    <!-- FIELDS -->
    <!-- ========================= -->

    <field name="nombreInvestigador" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="institucion" class="java.lang.String"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="fecha" class="java.time.LocalDate"/>

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <pageHeader>
        <band height="100" splitType="Stretch">

            <image scaleImage="RetainShape">
                <reportElement x="0" y="10" width="60" height="60">
                    <printWhenExpression><![CDATA[$P{LOGO_PATH} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression>
            </image>

            <textField>
                <reportElement style="Heading2" x="70" y="10" width="500" height="20"/>
                <textFieldExpression><![CDATA[$P{SISTEMA_NOMBRE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="Title" x="70" y="32" width="500" height="30"/>
                <textFieldExpression><![CDATA[$P{REPORTE_TITULO}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="FooterText" x="600" y="10" width="180" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Fecha: " + $P{FECHA_GENERACION}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="80" width="782" height="1" forecolor="#1E3A5F"/>
            </line>

        </band>
    </pageHeader>

    <!-- ========================= -->
    <!-- COLUMN HEADER -->
    <!-- ========================= -->

    <columnHeader>
        <band height="24">

            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="160" height="24"/>
                <text><![CDATA[Investigador]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="160" y="0" width="180" height="24"/>
                <text><![CDATA[Certificación]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="340" y="0" width="150" height="24"/>
                <text><![CDATA[Institución]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="490" y="0" width="100" height="24"/>
                <text><![CDATA[Tipo]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="590" y="0" width="90" height="24"/>
                <text><![CDATA[Estado]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="680" y="0" width="102" height="24"/>
                <text><![CDATA[Fecha]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ========================= -->
    <!-- DETAIL -->
    <!-- ========================= -->

    <detail>
        <band height="24" splitType="Stretch">

            <!-- Fondo alterno -->
            <rectangle>
                <reportElement x="0" y="0" width="782" height="24"
                               backcolor="#F5F5F5" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
            </rectangle>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="0" y="0" width="160" height="24" positionType="Float"/>
                <textElement><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{nombreInvestigador}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="160" y="0" width="180" height="24" positionType="Float"/>
                <textElement><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="340" y="0" width="150" height="24" positionType="Float"/>
                <textElement><paragraph leftIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{institucion}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="490" y="0" width="100" height="24" positionType="Float"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="590" y="0" width="90" height="24" positionType="Float"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="TableCell" x="680" y="0" width="102" height="24" positionType="Float"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[
                    $F{fecha} != null ?
                    $F{fecha}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")) : ""
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ========================= -->
    <!-- FOOTER -->
    <!-- ========================= -->

    <pageFooter>
        <band height="30">

            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#D9D9D9"/>
            </line>

            <textField>
                <reportElement style="FooterText" x="0" y="8" width="500" height="20"/>
                <textFieldExpression><![CDATA[$P{PIE_TEXTO}]]></textFieldExpression>
            </textField>

            <textField evaluationTime="Report">
                <reportElement style="FooterText" x="500" y="8" width="282" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    "Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}
                ]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

</jasperReport>